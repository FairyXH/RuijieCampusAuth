#!/bin/sh

# First-boot defaults for the R3G full image.
#
# Everything that can work without user credentials is enabled here:
# campus authentication/disguise, DoH, uplink failover, SQM, traffic
# accounting and UPnP. OpenClash and frpc stay installed but stopped until
# a subscription or server is configured, so an unattended router never
# retries a placeholder endpoint forever.
#
# The zz- prefix makes this run after every package uci-defaults script,
# including luci-openclash and luci-ua3f.

for service in ua3f ruijie-disguise ruijie-auth https-dns-proxy \
	mwan3 sqm nlbwmon vnstat miniupnpd upnpd p910nd watchcat usbipd; do
	[ -x "/etc/init.d/$service" ] && /etc/init.d/"$service" enable
done

# These two need external configuration before they are useful.
for service in openclash frpc; do
	[ -x "/etc/init.d/$service" ] && {
		/etc/init.d/"$service" stop
		/etc/init.d/"$service" disable
	}
done

# Chinese LuCI by default; users can switch back to auto/English in LuCI.
uci -q set luci.main.lang='zh_cn'
uci -q commit luci

# The R3G campus port is always the logical wan interface. "auto" can pick
# the USB tethering eth1 as soon as a phone is plugged in, which pauses the
# real campus authentication. Pin it once; users can still change it later.
if [ -f /etc/config/ruijie-auth ]; then
	uci -q set ruijie-auth.main.device='wan'
	uci commit ruijie-auth
	/etc/init.d/ruijie-auth reload >/dev/null 2>&1 || true
fi

# Bind the web UI to all addresses. Binding 10.0.0.1 directly makes uhttpd
# exit with "Address not available" when it starts before the LAN address
# exists; the firewall still rejects WAN-side input.
uci -q set uhttpd.main.listen_http='0.0.0.0:80'
uci -q set uhttpd.main.listen_https='0.0.0.0:443'
uci commit uhttpd
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true

# Put the USB tethering and Wi-Fi STA interfaces into the existing wan
# firewall zone. Both names are referenced by mwan3 but only appear when
# the corresponding uplink is actually configured.
wan_zone=$(uci show firewall 2>/dev/null | \
	sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n1)
if [ -n "$wan_zone" ]; then
	for net in usbwan wwan; do
		uci -q del_list "firewall.$wan_zone.network=$net"
		uci -q add_list "firewall.$wan_zone.network=$net"
	done
	uci commit firewall
fi

# Uplink rules are IPv4-only; the IPv6 policy stays unreachable because
# IPv6 is disabled in sysctl. Forcing this also fixes upgrades where the
# old /etc/config/mwan3 is preserved from the overlay.
if [ -f /etc/config/mwan3 ]; then
	uci -q set mwan3.default_rule.family='ipv4'
	uci commit mwan3
fi

# SQM parameters are easy to lose across sysupgrade because the old overlay
# config wins over the image file. Enforce the intended defaults once.
if [ -f /etc/config/sqm ]; then
	uci -q set sqm.wan.enabled='1'
	uci -q set sqm.wan.interface='wan'
	uci -q set sqm.wan.download='95000'
	uci -q set sqm.wan.upload='95000'
	uci -q set sqm.wan.qdisc='cake'
	uci -q set sqm.wan.script='piece_of_cake.qos'
	uci -q set sqm.wan.qdisc_advanced='0'
	uci -q set sqm.wan.qdisc_really_really_advanced='1'
	uci -q set sqm.wan.iqdisc_opts='dual-dsthost'
	uci -q set sqm.wan.eqdisc_opts='dual-srchost'
	uci -q set sqm.wan.linklayer='ethernet'
	uci -q set sqm.wan.overhead='0'
	uci commit sqm
	/etc/init.d/sqm restart >/dev/null 2>&1 || true
fi

# UA3F connection-level desync. Reorder is cheap and TLS-safe; inject
# breaks HTTPS on this campus network, so it stays off.
if [ -f /etc/config/ua3f ]; then
	uci -q set ua3f.main.desync_reorder='1'
	uci -q set ua3f.main.desync_reorder_bytes='1500'
	uci -q set ua3f.main.desync_reorder_packets='8'
	uci -q set ua3f.main.desync_inject='0'
	uci -q set ua3f.main.desync_inject_ttl='3'
	uci -q set ua3f.main.desync_ports='80,443'
	uci commit ua3f
	/etc/init.d/ua3f restart >/dev/null 2>&1 || true
fi

# OpenClash: redir-host with DNS hijacking off, so dnsmasq + https-dns-proxy
# stay in charge of DNS. The bundled mihomo core lives in /etc/openclash/core,
# which is only used when small_flash_memory is 0. core_version stays 0 so
# OpenClash does not try to download a core on first start.
if [ -f /etc/config/openclash ]; then
	uci -q set openclash.config.enable='0'
	uci -q set openclash.config.operation_mode='redir-host'
	uci -q set openclash.config.en_mode='redir-host'
	uci -q set openclash.config.proxy_mode='rule'
	uci -q set openclash.config.enable_redirect_dns='0'
	uci -q set openclash.config.redirect_dns='0'
	uci -q set openclash.config.small_flash_memory='0'
	uci -q set openclash.config.core_version='0'
	uci -q set openclash.config.intranet_allowed='1'
	uci -q set openclash.config.router_self_proxy='1'
	uci -q set openclash.config.auto_update='0'
	uci commit openclash

	# luci-openclash registers a firewall include pointing at
	# /var/etc/openclash.include, a file that only exists while OpenClash
	# runs. Leaving it registered with the service stopped makes fw4 fail
	# to load its ruleset on the next reload. The OpenClash init script
	# re-adds the include when the user enables the service.
	uci -q delete firewall.openclash
	uci commit firewall
fi

# UPnP: LAN side only, secure mode. The external interface is left dynamic
# so it follows whichever uplink mwan3 currently prefers.
if [ -f /etc/config/upnpd ]; then
	uci -q set upnpd.config.enabled='1'
	uci -q set upnpd.config.enable_upnp='1'
	uci -q set upnpd.config.enable_natpmp='1'
	uci -q set upnpd.config.secure_mode='1'
	uci -q set upnpd.config.internal_iface='lan'
	uci commit upnpd
fi

# Traffic accounting must live on the overlay, not /var (tmpfs). vnstat
# saves every 15 minutes instead of the default 5 to spare the NAND, and
# nlbwmon already commits only once per day.
if [ -f /etc/vnstat.conf ]; then
	mkdir -p /etc/vnstat
	sed -i \
		-e 's|^;DatabaseDir.*|DatabaseDir "/etc/vnstat"|' \
		-e 's|^DatabaseDir .*|DatabaseDir "/etc/vnstat"|' \
		-e 's|^;SaveInterval .*|SaveInterval 5|' \
		-e 's|^SaveInterval .*|SaveInterval 5|' \
		/etc/vnstat.conf
fi
if [ -f /etc/config/nlbwmon ]; then
	mkdir -p /etc/nlbwmon
	uci -q set nlbwmon.@nlbwmon[0].database_directory='/etc/nlbwmon'
	uci -q set nlbwmon.@nlbwmon[0].commit_interval='1h'
	uci -q commit nlbwmon
fi

# USB/IP server: LAN-side export of USB devices (adb, serial, storage).
if [ -f /etc/config/usbipd ]; then
	uci -q set usbipd.server.enable='1'
	uci -q set usbipd.server.port='3240'
	uci -q set usbipd.server.ipv4='1'
	uci -q set usbipd.server.ipv6='0'
	uci commit usbipd
fi

exit 0
