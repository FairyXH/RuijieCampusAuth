#!/bin/sh /etc/rc.common

# Fallback for the case where /etc/uci-defaults/zz-r3g-defaults is still
# present at the end of boot. Some sysupgrade paths preserve the overlay in
# a way that skips uci_apply_defaults; without this fallback the default
# language, stats persistence and firewall cleanup silently do not happen.
#
# The script is idempotent and deletes the defaults script after a
# successful run, so it only executes once per image.

START=99

start() {
	local defaults=/etc/uci-defaults/zz-r3g-defaults
	if [ -f "$defaults" ]; then
		if sh "$defaults"; then
			rm -f "$defaults"
		fi
	fi

	# vnstatd can start before its database is writable on the first boot
	# after sysupgrade. Re-add the monitored interfaces and restart once so
	# the database always ends up with wan and br-lan.
	if [ -x /etc/init.d/vnstat ]; then
		for iface in wan br-lan; do
			vnstat --add -i "$iface" >/dev/null 2>&1 || true
		done
		/etc/init.d/vnstat restart >/dev/null 2>&1 || true
	fi

	# The SQM rc.d link can be lost when the overlay is preserved across
	# sysupgrade. Restore it only when the user still has SQM enabled.
	if [ -x /etc/init.d/sqm ] &&
		[ "$(uci -q get sqm.wan.enabled)" = "1" ] &&
		! /etc/init.d/sqm enabled; then
		/etc/init.d/sqm enable
		/etc/init.d/sqm start
	fi

	# OpenClash's package default keeps the whole /etc/openclash in the
	# sysupgrade backup, including the 61MB core and 11MB GeoSite that
	# already live in the rootfs. Restrict the backup to user data so an
	# upgrade does not duplicate those files into the overlay.
	mkdir -p /lib/upgrade/keep.d
	cat >/lib/upgrade/keep.d/luci-app-openclash <<'EOF'
/etc/openclash/config/
/etc/openclash/custom/
/etc/openclash/overwrite/
/etc/openclash/rule_provider/
/etc/openclash/proxy_provider/
/etc/openclash/history/
/etc/config/openclash
EOF
}
