#!/bin/sh /etc/rc.common

# On-wire disguise for the R3G firmware.
#
# "basic" rewrites IPv4 TTL and TCP MSS with nftables only.
# "full" keeps those rules and also starts UA3F (NFQUEUE L3 rewrite:
# TTL/IPID/TCP timestamp/window). "off" removes the table and stops UA3F.
#
# The ruijie-auth ipk itself does not depend on UA3F or any kmod; this
# service belongs to the firmware image.

START=99

disguise_mode() {
	local value
	value=$(uci -q get ruijie-auth.main.disguise 2>/dev/null)
	[ -n "$value" ] || value=basic
	echo "$value"
}

start() {
	local mode
	mode=$(disguise_mode)
	if [ "$mode" = "off" ]; then
		stop
		return 0
	fi

	if command -v nft >/dev/null 2>&1; then
		nft delete table inet ruijie 2>/dev/null
		nft add table inet ruijie
		nft 'add chain inet ruijie post { type filter hook postrouting priority mangle; policy accept; }'
		nft 'add rule inet ruijie post tcp flags syn tcp option maxseg size set 1460'
		nft 'add rule inet ruijie post ip ttl set 128'
	fi

	if [ "$mode" = "full" ]; then
		# ua3f starts at S98; only start it here after a manual stop/reload.
		pidof ua3f >/dev/null 2>&1 || /etc/init.d/ua3f start 2>/dev/null
	else
		/etc/init.d/ua3f stop 2>/dev/null
	fi
}

stop() {
	/etc/init.d/ua3f stop 2>/dev/null
	command -v nft >/dev/null 2>&1 || return 0
	nft delete table inet ruijie 2>/dev/null
	return 0
}

reload() {
	stop
	start
}
