# Uplink order: campus WAN -> USB tethering -> Wi-Fi STA.
#
# Tracking uses plain ICMP to two public DNS anycast addresses. The campus
# network filters some HTTP 204 endpoints (connect.rom.miui.com was observed
# failing), and an unreliable target makes mwan3 flap every ~30 seconds.
# With flush_conntrack enabled each flap resets every client connection, so
# the target must be stable. ICMP to 223.5.5.5 is consistently ~20 ms here.

config globals 'globals'
	option mmx_mask '0x3F00'
	option loglevel 'notice'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option failure_interval '3'
	option recovery_interval '3'
	option down '3'
	option up '2'
	option flush_conntrack '1'

config interface 'usbwan'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option failure_interval '3'
	option recovery_interval '3'
	option down '3'
	option up '2'
	option flush_conntrack '1'

config interface 'wwan'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option failure_interval '3'
	option recovery_interval '3'
	option down '3'
	option up '2'
	option flush_conntrack '1'

config member 'wan_m1_w1'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'usbwan_m2_w1'
	option interface 'usbwan'
	option metric '2'
	option weight '1'

config member 'wwan_m3_w1'
	option interface 'wwan'
	option metric '3'
	option weight '1'

config policy 'failover'
	list use_member 'wan_m1_w1'
	list use_member 'usbwan_m2_w1'
	list use_member 'wwan_m3_w1'
	option last_resort 'unreachable'

config rule 'default_rule'
	option family 'ipv4'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option sticky '0'
	option policy 'failover'
