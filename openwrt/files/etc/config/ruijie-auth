config auth 'main'
	option enabled '1'
	option device 'auto'
	option auth_mode 'EAPMD5'
	option timeout '20'
	option retries '4'
	option repeats '3'
	option start_timeout '3'
	option response_delay '0.04'
	option reauth_interval '21600'
	option check_interval '2'
	option retry_interval '3'
	option autoguard '1'
	option preempt '1'
	option private_tail '1'
	option logoff_first '1'
	option discovery_cache '1'
	option logoff_on_stop '0'
	option pause_on_home '1'
	# 外网探测：先并行 TCP 多目标（任一回复即在线），全部失败再试 HTTP 204。
	option connectivity_url 'http://connect.rom.miui.com/generate_204'
	option connectivity_timeout '2'
	list connectivity_targets '223.5.5.5:53'
	list connectivity_targets '119.29.29.29:53'
	list connectivity_targets '180.76.76.76:53'
	list connectivity_targets '114.114.114.114:53'
	option dhcp_mode 'none'
	option dhcp_timeout '30'
	option dhcp_option82 '0'
	option ad_timeout '120'
	option disguise 'full'
	option log_level 'info'
