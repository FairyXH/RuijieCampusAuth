config auth 'main'
	option enabled '1'
	option device 'auto'
	option auth_mode 'EAPMD5'
	option timeout '20'
	option retries '4'
	option repeats '3'
	option start_timeout '3'
	option response_delay '0.04'
	# 0 = never re-authenticate a healthy session on a timer. Server-side
	# reauth requests are still answered; disconnect/preemption still retries.
	option reauth_interval '0'
	option proactive_reauth '0'
	# Campus auth is closed 00:00-06:00; pause automatic attempts then.
	option quiet_window '1'
	option quiet_start '0'
	option quiet_end '360'
	option check_interval '2'
	option retry_interval '3'
	# SAM 直通心跳：默认关闭；仅当 SAM 直通目标可达时手动开启。
	option heartbeat '0'
	option autoguard '1'
	option preempt '1'
	option private_tail '1'
	option logoff_first '1'
	option discovery_cache '1'
	option logoff_on_stop '0'
	option pause_on_home '1'
	# 外网探测：先并行做真实 DNS 查询 + TCP 53，任一成功即在线；
	# 全部失败后再用 Baidu/Bing/QQ 二次确认。
	option connectivity_domain 'www.baidu.com'
	option connectivity_url 'https://www.baidu.com/'
	list connectivity_fallbacks 'https://www.bing.com/'
	list connectivity_fallbacks 'https://www.qq.com/'
	option connectivity_timeout '2'
	list connectivity_targets '223.5.5.5:53'
	list connectivity_targets '119.29.29.29:53'
	list connectivity_targets '180.76.76.76:53'
	list connectivity_targets '114.114.114.114:53'
	option dhcp_mode 'none'
	option dhcp_timeout '30'
	option dhcp_option82 '0'
	option ad_timeout '120'
	option disguise 'full'
	option log_level 'info'
