# CAKE on the campus WAN, per-host fair sharing.
#
# Disabled by default. Measured on this MT7621 board with UA3F active:
#   SQM off          -> 82 Mbit, 71-81 ms under full download
#   CAKE 98M/rtt30ms -> 46 Mbit, 26-33 ms under full download
# Both ingress and egress run a per-packet queue, so CAKE costs roughly
# 35-40 Mbit here. Throughput won; enable this in
# LuCI -> Network -> SQM QoS when a link needs latency shaping more than
# speed. The parameters below are kept so turning it on is one click.
#
# dual-srchost/dual-dsthost make CAKE isolate individual LAN hosts, so one
# download cannot starve every other device.

config queue 'wan'
	option enabled '0'
	option interface 'wan'
	option download '95000'
	option upload '95000'
	option qdisc 'cake'
	option script 'piece_of_cake.qos'
	option qdisc_advanced '0'
	option ingress_ecn 'ECN'
	option egress_ecn 'ECN'
	option qdisc_really_really_advanced '1'
	option iqdisc_opts 'dual-dsthost'
	option eqdisc_opts 'dual-srchost'
	option linklayer 'ethernet'
	option overhead '0'
	option debug_logging '0'
	option verbosity '0'
