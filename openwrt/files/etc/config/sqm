# CAKE on the campus WAN, per-host fair sharing.
#
# The campus line is 100 Mbit; 95 Mbit leaves room for CAKE to be the
# bottleneck, which is required for host isolation to work. Set the real
# line rate (about 90-95% of it) in LuCI -> Network -> SQM QoS if it differs.
#
# dual-srchost/dual-dsthost make CAKE isolate individual LAN hosts, so one
# download cannot starve every other device. This is the part that solves
# the "one tablet saturates the link" problem; bandwidth alone does not.

config queue 'wan'
	option enabled '1'
	option interface 'wan'
	option download '95000'
	option upload '95000'
	option qdisc 'cake'
	option script 'piece_of_cake.qos'
	option qdisc_advanced '0'
	option ingress_ecn 'ECN'
	option egress_ecn 'ECN'
	option qdisc_really_really_advanced '1'
	option iqdisc_opts 'dual-dsthost'
	option eqdisc_opts 'dual-srchost'
	option linklayer 'ethernet'
	option overhead '0'
	option debug_logging '0'
	option verbosity '0'
