config ua3f 'enabled'
	option enabled '1'

config ua3f 'main'
	option server_mode 'NFQUEUE'
	option bind '127.0.0.1'
	option port '1080'
	# UA rewriting is intentionally OFF: UA3F cannot classify apps reliably,
	# and forcing a single UA can break WeChat/WeCom. L3 rewrite stays enabled.
	option rewrite_mode 'DIRECT'
	option ua 'FFF'
	option ua_regex ''
	option partial_replace '0'
	option log_level 'INFO'
	option l3_rewrite_ttl '1'
	option l3_rewrite_ttl_value '128'
	# IPID 改写会把几乎所有 TCP 包送入 NFQUEUE，MT7621 上会打满 CPU；
	# 默认关闭，保留 TTL / TCP timestamp / TCP window（仅 SYN 入队）。
	option l3_rewrite_ipid '0'
	option l3_rewrite_tcpts '1'
	option l3_rewrite_tcpwin '1'
	option l3_rewrite_block_quic '0'
	option l3_rewrite_bpf_offload '0'
	# 连接级 desync：只有新连接建立阶段处理，CPU 开销接近零。
	# reorder 会打乱 80/443 新连接前 8 个包、总量 <1500 字节的包序；
	# Windows 的 TCP 栈能靠重传硬扛，但 Android/iOS 会直接判定超时
	# （实测一加 Ace 5 与平板所有网页 ERR_CONNECTION_TIMED_OUT，
	# 关闭后立即恢复）。TTL/timestamp/window 改写不破坏 TCP 语义，保留。
	# inject 在本校园网会让 HTTPS 握手 EOF，同样保持关闭。
	option desync_reorder '0'
	option desync_reorder_bytes '1500'
	option desync_reorder_packets '8'
	option desync_inject '0'
	option desync_inject_ttl '3'
	option desync_ports '80,443'
	option header_rewrite '[]'
	option body_rewrite '[]'
	option url_redirect '[]'
