#!/bin/sh

# Adopt an Android/iPhone USB tethering netdev as the backup WAN.
# Android usually exposes RNDIS (usb0) or CDC-NCM (wwan0), older
# devices use CDC-Ethernet (usb0); the driver path check keeps us
# from grabbing a non-USB port that happens to use the same name.

[ "$ACTION" = "add" ] || exit 0

case "$INTERFACE" in
	usb*|wwan*) ;;
	*) exit 0 ;;
esac

[ -e "/sys/class/net/$INTERFACE/device" ] || exit 0
case "$(readlink -f "/sys/class/net/$INTERFACE/device/driver" 2>/dev/null)" in
	*/usb/*) ;;
	*) exit 0 ;;
esac

if ! uci -q get network.usbwan >/dev/null 2>&1; then
	uci set network.usbwan=interface
	uci set network.usbwan.proto='dhcp'
	uci set network.usbwan.device="$INTERFACE"
	uci set network.usbwan.metric='100'
	uci commit network
	logger -t hxxy-usbwan "created usbwan on $INTERFACE"
else
	cur=$(uci -q get network.usbwan.device)
	if [ "$cur" != "$INTERFACE" ]; then
		uci set network.usbwan.device="$INTERFACE"
		uci commit network
		logger -t hxxy-usbwan "usbwan now uses $INTERFACE"
	fi
fi

ifup usbwan >/dev/null 2>&1 || true
