#!/bin/sh
# Restore non-built-in packages cached in /etc/custom-packages or on a USB
# stick (/mnt/*/custom-packages). The cache may contain .ipk files and an
# executable install.sh; install.sh runs as root from the cache directory.
#
# This is intentionally not automatic at every boot: the firmware's
# uci-defaults wrapper runs it once after a sysupgrade, and the user can run
# this command manually after plugging the USB stick in.

restore_from() {
	local dir="$1"
	[ -x "$dir/install.sh" ] || return 1
	logger -t custom-packages "restoring from $dir"
	if ( cd "$dir" && sh ./install.sh ) >>/tmp/custom-packages.log 2>&1; then
		logger -t custom-packages "restored from $dir"
		return 0
	fi
	logger -t custom-packages "install.sh failed in $dir"
	return 1
}

for i in 1 2 3 4 5 6; do
	for dir in /etc/custom-packages /mnt/*/custom-packages; do
		[ -d "$dir" ] || continue
		restore_from "$dir" && exit 0
	done
	sleep 10
done

logger -t custom-packages "no successful install.sh in /etc/custom-packages or /mnt/*/custom-packages"
exit 0
