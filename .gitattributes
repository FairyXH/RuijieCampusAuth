# Shell scripts and OpenWrt init/hotplug files are executed on Linux and
# OpenWrt. Keep them LF even when the repository is checked out on Windows.
# build-image.sh copies openwrt/files verbatim into the image, so a CRLF
# checkout would ship unusable shell scripts and UCI configs to the router.
*.sh text eol=lf
openwrt/files/** text eol=lf
openwrt/luci-app-ruijie-auth/root/etc/uci-defaults/* text eol=lf
openwrt/scripts/profiles/*.env text eol=lf
openwrt/scripts/packages/*.txt text eol=lf
openwrt/**/SHA256SUMS text eol=lf
openwrt/**/latest.txt text eol=lf
openwrt/firmware/**/BUILD_INFO.txt text eol=lf
openwrt/firmware/**/*.manifest text eol=lf
